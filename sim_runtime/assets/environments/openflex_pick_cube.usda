#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Cube "PickCube" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsMassAPI"]
    )
    {
        double size = 1
        float3 xformOp:scale = (0.05, 0.05, 0.05)
        uniform token[] xformOpOrder = ["xformOp:scale"]
        bool physics:rigidBodyEnabled = true
        float physics:mass = 0.08
        color3f[] primvars:displayColor = [(0.88, 0.16, 0.12)]
    }
}
