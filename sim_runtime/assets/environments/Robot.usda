                                    {
                                        uniform token[] xformOpOrder = ["!resetXformStack!", "xformOp:translate", "xformOp:orient", "xformOp:scale"]

                                        over "openarmx_left_link6"
                                        {
                                            uniform token[] xformOpOrder = ["!resetXformStack!", "xformOp:translate", "xformOp:orient", "xformOp:scale"]

                                            over "openarmx_left_link7"
                                            {
                                                uniform token[] xformOpOrder = ["!resetXformStack!", "xformOp:translate", "xformOp:orient", "xformOp:scale"]

                                                over "openarmx_left_right_finger"
                                                {
                                                    uniform token[] xformOpOrder = ["!resetXformStack!", "xformOp:translate", "xformOp:orient", "xformOp:scale"]
                                                }

                                                over "openarmx_left_left_finger"
                                                {
                                                    uniform token[] xformOpOrder = ["!resetXformStack!", "xformOp:translate", "xformOp:orient", "xformOp:scale"]
                                                }

                                                def "OpenFlexRuntimeLinks"
                                                {
                                                    def Xform "openarmx_left_hand"
                                                    {
                                                        custom string urdf:name = "openarmx_left_hand"
                                                        custom quatd xformOp:orient = (1, 0, 0, 0)
                                                        custom double3 xformOp:scale = (1, 1, 1)
                                                        custom double3 xformOp:translate = (0, 0, 0.1001)
                                                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                                                        def "OpenFlexRuntimeLinks"
                                                        {
                                                            def Xform "openarmx_left_hand_tcp"
                                                            {
                                                                custom string urdf:name = "openarmx_left_hand_tcp"
                                                                custom quatd xformOp:orient = (1, 0, 0, 0)
                                                                custom double3 xformOp:scale = (1, 1, 1)
                                                                custom double3 xformOp:translate = (0, 0, 0.08)
                                                                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                                                                def Xform "LeftWristCameraMount"
                                                                {
                                                                    custom quatd xformOp:orient = (0.30070579950427306, 3.998540080892181e-17, 0.9537169507482269, 4.2819420214969975e-17)
                                                                    custom double3 xformOp:scale = (1, 1, 1)
                                                                    custom double3 xformOp:translate = (0.0672052588340929, -0.01250108166453956, -0.061670653901868544)
                                                                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                                                                    def Xform "OpenFlexSensors"
                                                                    {
                                                                        def Camera "LeftHandColorCamera"
                                                                        {
                                                                            float2 clippingRange = (0.02, 100)
                                                                            custom float exposure:iso = 50
                                                                            float focalLength = 18.147562
                                                                            float focusDistance = 4
                                                                            custom float omni:sensor:tickRate = 30
                                                                            custom string openflex:sensor:type = "rgb"
                                                                            custom quatd xformOp:orient = (1, 0, 0, 0)
                                                                            custom double3 xformOp:scale = (1, 1, 1)
                                                                            custom double3 xformOp:translate = (0, 0, 0)
                                                                            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                                                                            def OmniGraph "ROS2_rgb_Graph"
