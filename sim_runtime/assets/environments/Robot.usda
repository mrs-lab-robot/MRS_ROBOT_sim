                    over "br_wheel_link"
                    {
                        uniform token[] xformOpOrder = ["!resetXformStack!", "xformOp:translate", "xformOp:orient", "xformOp:scale"]
                    }
                }

                over "lift_carriage_link"
                {
                    uniform token[] xformOpOrder = ["!resetXformStack!", "xformOp:translate", "xformOp:orient", "xformOp:scale"]

                    over "openarmx_left_link1"
                    {
                        uniform token[] xformOpOrder = ["!resetXformStack!", "xformOp:translate", "xformOp:orient", "xformOp:scale"]

                        over "openarmx_left_link2"
                        {
                            uniform token[] xformOpOrder = ["!resetXformStack!", "xformOp:translate", "xformOp:orient", "xformOp:scale"]

                            over "openarmx_left_link3"
                            {
                                uniform token[] xformOpOrder = ["!resetXformStack!", "xformOp:translate", "xformOp:orient", "xformOp:scale"]

                                over "openarmx_left_link4"
                                {
