#usda 1.0

(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "OpenFlex" (
        prepend references = @../robots/openflex_robot.usda@
    )
    {
        over "Geometry"
        {
            over "base_link" (
                prepend apiSchemas = ["PhysxArticulationAPI"]
            )
            {
                float physxArticulation:sleepThreshold = 0
                int physxArticulation:solverPositionIterationCount = 32
                int physxArticulation:solverVelocityIterationCount = 4
                float physxArticulation:stabilizationThreshold = 0
            }
        }
    }

    def PhysicsScene "physicsScene" (
        prepend apiSchemas = ["NewtonSceneAPI", "PhysxSceneAPI"]
    )
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
    }
}
