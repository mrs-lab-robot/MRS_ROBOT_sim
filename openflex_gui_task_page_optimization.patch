+    def test_simulation_task_page_has_stable_configuration_sections(self):
+        """The task page keeps selection and randomization in one styled surface."""
+        self.window.btn_runtime_mode_sim.click()
+        page = self.window.page_stack.widget(PAGE_SCENE_TASK)
+
+        title = page.findChild(QLabel, "sceneTaskPageTitle")
+        subtitle = page.findChild(QLabel, "sceneTaskPageSubtitle")
+        selection_panel = self.window.arena_control_panel.selection_panel
+        randomization_panel = self.window.arena_control_panel.reset_randomization_panel
+        summary = page.findChild(QLabel, "arenaTaskConfigurationSummary")
+
+        self.assertIsNotNone(title)
+        self.assertIsNotNone(subtitle)
+        self.assertIsNotNone(summary)
+        self.assertEqual(selection_panel.objectName(), "arenaSceneTaskSelector")
+        self.assertTrue(selection_panel.property("card"))
+        self.assertTrue(page.isAncestorOf(selection_panel))
+        self.assertTrue(page.isAncestorOf(randomization_panel))
+        self.assertEqual(randomization_panel.parentWidget(), selection_panel)
+        self.assertEqual(randomization_panel.property("section"), "randomization")
+        self.assertIn("场景", summary.text())
+
+        previous_summary = summary.text()
+        scene_combo = page.findChild(QComboBox, "arenaSceneCombo")
+        self.assertIsNotNone(scene_combo)
+        if scene_combo.count() > 1:
+            scene_combo.setCurrentIndex(1)
+            self.app.processEvents()
+            self.assertNotEqual(summary.text(), previous_summary)
